{
  "expo": {
    "name": "MojKutak",
    "owner": "loop1870",
    "slug": "mojkutak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mojkutak",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7A4B2A"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#7A4B2A"
    },
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "eu.usluge.mojkutak",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7A4B2A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MojKutak koristi vašu lokaciju za prikaz objekata u blizini."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A4B2A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06af9595-2821-4407-a67d-2f3fc0f78e4e"
      }
    }
  }
}
